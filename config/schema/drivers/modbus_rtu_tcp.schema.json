{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xedge.example.com/schema/drivers/modbus_rtu_tcp.schema.json",
  "title": "Modbus RTU-over-TCP Driver Configuration",
  "description": "Per-driver-type schema for `type: modbus_rtu_tcp` entries (FR-DF-004, FR-SA-003, FR-SA-004, FR-SA-009). RTU framing (address+PDU+CRC) carried over TCP, distinct from Modbus TCP's MBAP framing.",
  "type": "object",
  "required": ["config", "tag_groups"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["host"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 502 },
        "unit_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 247,
          "default": 1,
          "description": "Bus address, FR-SA-001."
        },
        "connect_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
        "read_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 3 }
      }
    },
    "tag_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scan_rate_ms", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scan_rate_ms": { "type": "integer", "minimum": 50, "maximum": 86400000 },
          "deadband": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["absolute", "percentage"] },
              "value": { "type": "number", "minimum": 0 }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "function_code", "address"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "function_code": {
                  "type": "string",
                  "enum": [
                    "read_coils",
                    "read_discrete_inputs",
                    "read_holding_registers",
                    "read_input_registers"
                  ]
                },
                "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "scaling": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scale": { "type": "number", "default": 1.0 },
                    "offset": { "type": "number", "default": 0.0 }
                  }
                },
                "engineering_unit": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
