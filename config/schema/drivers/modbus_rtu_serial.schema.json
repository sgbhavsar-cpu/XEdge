{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xedge.example.com/schema/drivers/modbus_rtu_serial.schema.json",
  "title": "Modbus RTU Serial Driver Configuration",
  "description": "Per-driver-type schema for `type: modbus_rtu_serial` entries (FR-DF-004, FR-SA-001, FR-SA-004, FR-SA-009). RS-232/RS-485 over a real serial port.",
  "type": "object",
  "required": ["config", "tag_groups"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["port"],
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "string",
          "minLength": 1,
          "description": "Serial device path, e.g. /dev/ttyUSB0, /dev/ttyAMA0 (IR-HW-001)."
        },
        "baud_rate": {
          "type": "integer",
          "minimum": 1200,
          "maximum": 115200,
          "default": 9600,
          "description": "FR-SA-001: 1200-115200."
        },
        "parity": { "type": "string", "enum": ["none", "even", "odd"], "default": "none" },
        "data_bits": { "type": "integer", "enum": [7, 8], "default": 8 },
        "stop_bits": { "type": "integer", "enum": [1, 2], "default": 1 },
        "unit_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 247,
          "default": 1,
          "description": "Bus address, FR-SA-001."
        },
        "read_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 3 }
      }
    },
    "tag_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scan_rate_ms", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scan_rate_ms": { "type": "integer", "minimum": 50, "maximum": 86400000 },
          "deadband": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["absolute", "percentage"] },
              "value": { "type": "number", "minimum": 0 }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "function_code", "address"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "function_code": {
                  "type": "string",
                  "enum": [
                    "read_coils",
                    "read_discrete_inputs",
                    "read_holding_registers",
                    "read_input_registers"
                  ]
                },
                "address": { "type": "integer", "minimum": 0, "maximum": 65535 },
                "scaling": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scale": { "type": "number", "default": 1.0 },
                    "offset": { "type": "number", "default": 0.0 }
                  }
                },
                "engineering_unit": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
