{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xedge.example.com/schema/drivers/bacnet_ip.schema.json",
  "title": "BACnet/IP Driver Configuration",
  "description": "Per-driver-type schema for `type: bacnet_ip` entries (FR-DF-004). Built on bacpypes3 (MIT, ADR-006 \"buy\" decision). MVP scope: ReadProperty polling only, no COV subscriptions, no device discovery — each tag names its target device address and object directly, same granularity as the Modbus/OPC UA drivers.",
  "type": "object",
  "required": ["config", "tag_groups"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["local_address", "device_instance"],
      "additionalProperties": false,
      "properties": {
        "local_address": {
          "type": "string",
          "minLength": 1,
          "description": "This driver instance's own BACnet/IP bind address, e.g. '127.0.0.1:47809'. BACnet/IP's standard UDP port is 47808 — use a different port per driver instance sharing a host."
        },
        "device_instance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194303,
          "description": "This xEdge instance's own BACnet device instance number (must be unique on the BACnet network)."
        },
        "request_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 3,
          "description": "Per-request (ReadProperty) timeout; BACnet/IP has no persistent per-device session, so this bounds each individual read."
        }
      }
    },
    "tag_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scan_rate_ms", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scan_rate_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 86400000,
            "description": "100ms minimum sampling interval, matching the other polling drivers."
          },
          "deadband": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["absolute", "percentage"] },
              "value": { "type": "number", "minimum": 0 }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "device_address", "object_identifier"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "device_address": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Target device's BACnet address, e.g. '192.168.1.60:47808' or '192.168.1.60'."
                },
                "object_identifier": {
                  "type": "string",
                  "minLength": 1,
                  "description": "e.g. 'analog-input,1', 'binary-value,3', 'multi-state-value,2'."
                },
                "property_identifier": {
                  "type": "string",
                  "default": "present-value"
                },
                "scaling": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scale": { "type": "number", "default": 1.0 },
                    "offset": { "type": "number", "default": 0.0 }
                  }
                },
                "engineering_unit": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
