{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xedge.example.com/schema/drivers/modbus_tcp.schema.json",
  "title": "Modbus TCP Driver Configuration",
  "description": "Per-driver-type schema for `type: modbus_tcp` entries (FR-DF-004, FR-SA-002, FR-SA-004, FR-SA-009).",
  "type": "object",
  "required": ["config", "tag_groups"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["host"],
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 502 },
        "unit_id": { "type": "integer", "minimum": 0, "maximum": 255, "default": 1 },
        "connect_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
        "read_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 3 }
      }
    },
    "tag_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scan_rate_ms", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scan_rate_ms": {
            "type": "integer",
            "minimum": 50,
            "maximum": 86400000,
            "description": "FR-SA-009: 50ms minimum, 24h maximum."
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "function_code", "address"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "function_code": {
                  "type": "string",
                  "enum": [
                    "read_coils",
                    "read_discrete_inputs",
                    "read_holding_registers",
                    "read_input_registers"
                  ]
                },
                "address": { "type": "integer", "minimum": 0, "maximum": 65535 }
              }
            }
          }
        }
      }
    }
  }
}
