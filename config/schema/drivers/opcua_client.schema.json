{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xedge.example.com/schema/drivers/opcua_client.schema.json",
  "title": "OPC UA Client Driver Configuration",
  "description": "Per-driver-type schema for `type: opcua_client` entries (FR-DF-004, FR-SA-005..FR-SA-008). MVP scope: polling mode only, no security (ADR-006 §7 amendment — asyncua-backed).",
  "type": "object",
  "required": ["config", "tag_groups"],
  "additionalProperties": false,
  "properties": {
    "config": {
      "type": "object",
      "required": ["endpoint_url"],
      "additionalProperties": false,
      "properties": {
        "endpoint_url": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. opc.tcp://192.168.1.50:4840/freeopcua/server/"
        },
        "connect_timeout_seconds": { "type": "number", "exclusiveMinimum": 0, "default": 5 },
        "username": { "type": "string" },
        "password": { "type": "string", "x-secret": true }
      }
    },
    "tag_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "scan_rate_ms", "tags"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scan_rate_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 86400000,
            "description": "FR-UA-003: 100ms minimum sampling interval."
          },
          "deadband": {
            "type": "object",
            "required": ["type", "value"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["absolute", "percentage"] },
              "value": { "type": "number", "minimum": 0 }
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "node_id"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "node_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "OPC UA NodeId string, e.g. 'ns=2;i=1001' or 'ns=2;s=Temperature'."
                },
                "scaling": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "scale": { "type": "number", "default": 1.0 },
                    "offset": { "type": "number", "default": 0.0 }
                  }
                },
                "engineering_unit": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
